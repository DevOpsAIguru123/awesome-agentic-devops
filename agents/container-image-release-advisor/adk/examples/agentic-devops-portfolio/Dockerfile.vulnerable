# INTENTIONALLY VULNERABLE TRAINING FIXTURE. DO NOT PUBLISH OR DEPLOY.
# This digest was retained specifically because the July 2026 Trivy database
# reports multiple HIGH and CRITICAL Debian package vulnerabilities in it.
FROM --platform=linux/amd64 nginx@sha256:5a88c9c45479443d7be2eadc894b4ed0a9801bae03d97a5760ae13b5c2005942

COPY index.html styles.css app.js /usr/share/nginx/html/

# Deliberate misconfigurations for policy-gate testing:
# - writable web root
# - root runtime user
# - no container health check
RUN chmod -R 0777 /usr/share/nginx/html

USER root
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
