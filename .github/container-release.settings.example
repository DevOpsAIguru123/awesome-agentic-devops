# Copy this file to .github/container-release.settings and replace every value.
# The real settings file is ignored by Git.
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=REPLACE_ME_WITH_SONARQUBE_CLOUD_ORGANIZATION_KEY
SONAR_TOKEN=REPLACE_ME_WITH_SONARQUBE_PROJECT_TOKEN
DOCKERHUB_USERNAME=REPLACE_ME_WITH_DOCKERHUB_USERNAME
DOCKERHUB_REPOSITORY=agentic-devops-portfolio
DOCKERHUB_TOKEN=REPLACE_ME_WITH_DOCKERHUB_ACCESS_TOKEN
WIF_PROVIDER=REPLACE_ME_WITH_FULL_WIF_PROVIDER_RESOURCE_NAME
WIF_SERVICE_ACCOUNT=REPLACE_ME_WITH_SERVICE_ACCOUNT_EMAIL
GOOGLE_CLOUD_PROJECT=REPLACE_ME_WITH_VERTEX_AI_PROJECT_ID
ANTHROPIC_API_KEY=REPLACE_ME_WITH_ANTHROPIC_API_KEY
